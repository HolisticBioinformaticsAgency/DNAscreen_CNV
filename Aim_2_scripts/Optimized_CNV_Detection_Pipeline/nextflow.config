params {
    // ── Input ──────────────────────────────────────────────────────────────
    // CSV with header: run_id,bam_dir,vcf_dir  (one row per sequencing run)
    samplesheet = "${projectDir}/samplesheet_runs4-35.csv"
    outdir      = "${projectDir}/output/optimised_framework"

    // ── Reference / config files ──────────────────────────────────────────
    decon_params_nf    = "${projectDir}/decon/decon_params_nf.yaml"
    clearCNV_params_nf = "${projectDir}/clearCNV/clearCNV_params_nf.yaml"

    // BED used for read counts, outliers, read depth filter, RR and plots
    framework_bed = "${projectDir}/bed_files/9genes_25bp.fix.sorted.bed"
    // BED given to DECoN and clearCNV (overrides bed_file in the caller YAMLs).
    // When identical to framework_bed, DECoN reuses the stage-1 counts.
    caller_bed    = "${projectDir}/bed_files/9genes_25bp.fix.sorted.bed"

    // VCF matching: per-sample VCF in the run's vcf_dir; matched on the BAM
    // stem first, then on the sample ID regex
    vcf_pattern     = '\\.sorted\\.vcf\\.gz$'
    sample_id_regex = 'DNS\\d+'

    // ── Stage 1: outliers ─────────────────────────────────────────────────
    dbscan_minpts = 5

    // ── Stage 2: preliminary filtering ────────────────────────────────────
    bf_min         = 10     // DECoN Bayes factor, all DECoN calls
    min_read_count = 100    // mean read depth, single-exon calls only

    // ── Stage 3: prioritisation matrix ────────────────────────────────────
    reciprocal_overlap = 0.5

    // ── Stage 4: read ratio + VAF ─────────────────────────────────────────
    n_ref         = 20      // reference samples (lowest average percent difference)
    rr_tol        = 0.15    // RR1: in-call exon within +/- of 0.5 / 1.5
    rr_del_max    = 1.35    // RR2: deletion fails if an out-of-call exon RR >= this
    rr_dup_min    = 0.65    // RR2: duplication fails if an out-of-call exon RR <= this
    rr_max_spread = 0.5     // RR3: max - min in-call RR (multi-exon calls)
    vaf_max       = 0.95
    dp_min        = 30
    dup_min_prop_concordant = 0.5   // > this proportion of SNVs concordant
    dup_max_discordant      = 2     // at most this many discordant SNVs

    // ── Plots (on by default) ─────────────────────────────────────────────
    skip_plots           = false
    plot_vaf             = true
    plot_vaf_legend      = false
    plot_raw_depth       = false   // reads each BAM; slower
    plot_prelim_rejected = false   // also plot calls rejected at the preliminary filter
    plot_rr_min_max      = 2.5
    exon_track_rds       = ''      // optional biomaRt cache (cached_exon_data.rds); default: framework BED
}

process {
    cpus   = 8
    memory = "24 GB"
    time   = "12h"

    withLabel: 'r_small' {
        cpus   = 1
        memory = "8 GB"
        time   = "4h"
    }
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
}
